{
  "name": "mcp-gate",
  "version": "0.1.0",
  "description": "An MCP server for MCP servers: it connects to other MCP servers and exposes only the tools it decides to enable.",
  "private": true,
  "author": "pi314x",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pi314x/mcp-gate.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "mcp-gateway",
    "ai-agents"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mcp-gate": "dist/index.js"
  },
  "files": [
    "dist",
    "mcp-gate.config.example.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "check": "tsx src/index.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
